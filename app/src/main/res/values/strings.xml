    <!-- Onboarding -->
    <string name="onboarding_title">Before we start</string>
    <string name="onboarding_intro">Firefly works with no mobile signal. It needs a few permissions to talk to nearby phones and place you on the venue map.</string>
    <string name="onboarding_bt_title">Nearby devices (Bluetooth)</string>
    <string name="onboarding_bt_body">Your phone broadcasts a tiny Bluetooth signal with your position and relays your friends\' signals. No pairing, no connections.</string>
    <string name="onboarding_loc_title">Precise location</string>
    <string name="onboarding_loc_body">GPS puts your dot on the map. Android also requires location permission for Bluetooth scanning.</string>
    <string name="onboarding_notif_title">Notifications</string>
    <string name="onboarding_notif_body">A persistent notification keeps Firefly running while your screen is off.</string>
    <string name="onboarding_privacy">Your position is only shared with the group you join, is not encrypted in this test build, and is never stored after you leave the group. There is no server: Firefly does not even have internet permission.</string>
    <string name="onboarding_grant">Grant permissions</string>
    <string name="onboarding_denied">Firefly cannot work without these. Please allow them in Settings.</string>
    <string name="onboarding_open_settings">Open app settings</string>

